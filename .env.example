# ── Direct Vitor ─────────────────────────────────────────────
# Copiar este archivo a `.env` y ajustar los valores.
# NUNCA versionar `.env` (está excluido en .gitignore).

# Entorno: development | production
NODE_ENV=production

# Puerto HTTP
PORT=3000

# ── Base de datos PostgreSQL ─────────────────────────────────
# Opción A: conexión por partes (local / VPS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=direc_vitor

# Opción B: SUPABASE (recomendada para producción). Si DATABASE_URL está definido,
# se ignora DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME y se omite CREATE DATABASE.
# En el dashboard de Supabase: Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres
# SSL obligatorio con Supabase. Puede dejarse vacío (se activa solo con supabase.co) o en 'true'.
DB_SSL=true

# ── Supabase Storage (imágenes subidas por los usuarios) ─────
# Dejar vacío estas 3 claves para seguir guardando imágenes en disco local.
# Project Settings > API:
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
# Nombre del bucket público donde se suben las imágenes (se crea solo si no existe).
SUPABASE_BUCKET=media

# ── Seguridad ────────────────────────────────────────────────
# Secreto de firma de sesiones. GENERAR UNO ALEATORIO:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-por-uno-aleatorio

# Password inicial del usuario admin (solo se usa si la BD no tiene admin).
ADMIN_PASSWORD=cambia-este-password-admin

# Dominios permitidos para CORS (separados por coma).
# Vacío = solo mismo origen (recomendado si front y backend comparten dominio).
ALLOWED_ORIGINS=https://tu-dominio.com

# HTTPS: true si el server está detrás de un proxy/load balancer con TLS.
COOKIE_SECURE=true
TRUST_PROXY=true

# ── Modo demo (sin PostgreSQL) ───────────────────────────────
# Solo aplica en desarrollo. En producción NUNCA se activa, aunque este valor sea true.
DEMO_MODE=false